{
  "name": "opencode-kit",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --import tsx --test --test-reporter=dot \"tests/unit/**/*.test.ts\"",
    "test:integration": "node --import tsx --test --test-reporter=dot \"tests/integration/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@opencode-ai/sdk": "^1.18.31",
    "@opencode-ai/plugin": "^1.18.31",
    "opencode-ai": "1.18.31",
    "superpowers": "github:obra/superpowers#v6.3.0",
    "@types/node": "^22.20.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
