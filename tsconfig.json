{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "tools/**/*.ts",
    "plugins/**/*.ts",
    ".opencode/**/*.ts",
    "tests/**/*.ts"
  ]
}
