{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "insight": {
      "permission": {
        "*": "ask",
        "skill": {
          "customize-opencode": "allow",
          "opencode-debugging": "allow"
        }
      }
    }
  },
  "mcp": {
    "duckduckgo": { "enabled": true }
  }
}
